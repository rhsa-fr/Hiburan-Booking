# Tarlink — konfigurasi produksi
#
# Salin menjadi `.env.prod`, isi nilainya, lalu jalankan:
#   npm run verify:prod -- --db
#
# File ini TIDAK masuk git (`.env.*` di .gitignore, kecuali *.example).
# Jangan pernah menaruh nilai asli di file contoh ini.

# ---------------------------------------------------------------- runtime
NODE_ENV=production
PORT=3001

# ---------------------------------------------------------------- database
# Dipakai docker-compose.prod.yml untuk membuat service `db`.
POSTGRES_USER=tarlink
POSTGRES_PASSWORD=
POSTGRES_DB=tarlink
# Dipakai API/worker/migrate. Di dalam compose host-nya `db`.
DATABASE_URL=postgres://tarlink:ganti-sandi@db:5432/tarlink

# --------------------------------------------------------------- auth/JWT
# Buat: openssl rand -base64 48
JWT_SECRET=
JWT_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# Wajib false/kosong di produksi (kalau true, kode OTP ikut di respons).
OTP_DEV_MODE=false
LOGIN_IP_RATE_LIMIT_MAX=30
OTP_IP_RATE_LIMIT_MAX=10
# true bila API di belakang reverse proxy (nginx/Caddy/LB).
TRUST_PROXY=true
# Origin panel admin (https, tanpa wildcard). Dipisah koma.
CORS_ORIGINS=https://admin.tarlink.id

# ----------------------------------------------------------------- email
# Kanal OTP (ADR 0011) DAN notifikasi keluar booking (FR-051, worker).
# Tanpa ini login OTP tidak bisa dipakai dan email status booking tidak terkirim.
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=Tarlink <no-reply@tarlink.id>

# --------------------------------------------------------------- media
UPLOAD_DIR=storage/uploads
PRIVATE_UPLOAD_DIR=storage/private
# Origin publik media (di-inline juga saat build panel).
MEDIA_PUBLIC_BASE_URL=https://api.tarlink.id
NEXT_PUBLIC_API_BASE_URL=https://api.tarlink.id
NEXT_PUBLIC_USE_MOCK=false
# Opsional: tanpa client id, tombol Google disembunyikan.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------- payment gateway
PJP_PROVIDER=midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_BASE_URL=
REFUND_APPROVAL_THRESHOLD_IDR=1000000

# ------------------------------------------------------------- payout
# `iris` untuk pencairan nyata. `local` hanya untuk uji internal dan akan
# ditolak `verify:prod` kecuali dijalankan dengan --allow-local-payout.
PAYOUT_PROVIDER=iris
IRIS_API_KEY=
IRIS_IS_PRODUCTION=true
IRIS_BASE_URL=
LOCAL_PAYOUT_DELAY_MS=0

# ------------------------------------------------------- kunci enkripsi
# Semua base64 dari 32 byte acak:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=
TOTP_ENCRYPTION_KEY_PREVIOUS=
KTP_ENCRYPTION_KEY=
BANK_ACCOUNT_ENCRYPTION_KEY=
BANK_ACCOUNT_ENCRYPTION_KEY_PREVIOUS=
BANK_ACCOUNT_KEY_ID=v1

# ---------------------------------------------------------------- worker
WORKER_TICK_MS=15000
WORKER_BATCH=50
WORKER_MAX_TICKS=0

# ------------------------------------------------- port host (compose)
# Hanya di-bind ke 127.0.0.1; reverse proxy yang menghadap internet.
API_PORT=3001
ADMIN_PORT=3002
