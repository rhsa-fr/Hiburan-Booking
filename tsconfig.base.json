{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@tarlink/core/*": ["apps/api/src/core/*"],
      "@tarlink/platform/*": ["libs/platform/*/src/index.ts"],
      "@tarlink/modules/*": ["libs/modules/*/src/index.ts"]
    }
  }
}
