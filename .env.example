# API
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://tarlink:tarlink@localhost:5432/tarlink
JWT_SECRET=change-me-in-production
JWT_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# dev_code OTP hanya keluar bila NODE_ENV != production DAN flag ini true.
OTP_DEV_MODE=true
# Rate limit per IP (selain kuota per email).
LOGIN_IP_RATE_LIMIT_MAX=30
OTP_IP_RATE_LIMIT_MAX=10
# OTP dikirim ke email (ADR 0011). Kosongkan EMAIL_API_URL di dev: OTP hanya
# ditulis ke log tanpa kode, dan dev_code dipakai bila OTP_DEV_MODE=true.
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=Tarlink <no-reply@tarlink.id>
# true bila API di belakang reverse proxy (Railway/nginx) agar @Ip() benar.
TRUST_PROXY=false

# Media vendor (upload lokal). MEDIA_PUBLIC_BASE_URL opsional; bila kosong,
# URL memakai host request (cocok untuk dev/emulator).
UPLOAD_DIR=storage/uploads
MEDIA_PUBLIC_BASE_URL=

# Payment gateway.
# `local`   = deterministic, no network (dipakai test/dev tanpa kredensial)
# `midtrans` = Midtrans Core API; sandbox secara default.
PJP_PROVIDER=midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Kosongkan untuk memakai default: https://api.sandbox.midtrans.com
MIDTRANS_BASE_URL=
# Legacy HMAC webhook; hanya dipakai bila PJP_PROVIDER=local.
PJP_WEBHOOK_SECRET=
# Refund di atas nominal ini wajib dua admin berbeda (FR-128).
REFUND_APPROVAL_THRESHOLD_IDR=1000000

# Berkas privat (foto KTP vendor). Tidak diserve lewat /v1/media.
PRIVATE_UPLOAD_DIR=storage/private
# AES-256-GCM untuk file KTP. WAJIB di production; API menolak boot tanpa ini.
# Buat dengan: openssl rand -base64 32
KTP_ENCRYPTION_KEY=

# Payout vendor (disbursement).
# `local` = stub deterministik tanpa jaringan (dev/test).
# `iris`  = Midtrans Iris; API key terpisah dari MIDTRANS_SERVER_KEY.
PAYOUT_PROVIDER=local
IRIS_API_KEY=
IRIS_IS_PRODUCTION=false
# Kosongkan untuk default sandbox: https://app.sandbox.midtrans.com/iris/api/v1
IRIS_BASE_URL=
# Kunci enkripsi nomor rekening vendor: base64 dari 32 byte.
# Buat dengan: openssl rand -base64 32
# Tanpa kunci ini, POST /v1/vendor/bank-accounts ditolak (endpoint baca tetap jalan).
BANK_ACCOUNT_ENCRYPTION_KEY=
# Isi hanya saat merotasi kunci; baris lama tetap bisa didekripsi.
BANK_ACCOUNT_ENCRYPTION_KEY_PREVIOUS=
BANK_ACCOUNT_KEY_ID=v1
# Jeda status `processing` -> `completed` pada gateway lokal (milidetik).
LOCAL_PAYOUT_DELAY_MS=0

# Admin panel
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_USE_MOCK=false

# Google Sign-In (opsional; tanpa client id, tombol Google disembunyikan)
# Buat OAuth Client ID di Google Cloud Console > APIs & Services > Credentials.
# Authorized redirect URI (web): http://localhost:3002/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Worker (apps/worker) - poller PostgreSQL, tanpa Redis
WORKER_TICK_MS=15000
WORKER_BATCH=50
# 0 = berjalan terus; >0 = berhenti setelah N tick (untuk uji deterministik)
WORKER_MAX_TICKS=0

# Origin yang boleh memanggil API (dipisah koma). 8080 = mobile web dev.
CORS_ORIGINS=http://localhost:3002,http://localhost:8080

# FR-128: base64 dari 32 byte acak. Tanpa kunci ini enrollment/verifikasi 2FA
# gagal tertutup (fail closed). Di production nilainya wajib.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=
TOTP_ENCRYPTION_KEY_PREVIOUS=
