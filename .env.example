# API
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://tarlink:tarlink@localhost:5432/tarlink
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
JWT_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# dev_code OTP hanya keluar bila NODE_ENV != production DAN flag ini true.
OTP_DEV_MODE=true
# Rate limit per IP (selain kuota per email/phone).
LOGIN_IP_RATE_LIMIT_MAX=30
OTP_IP_RATE_LIMIT_MAX=10
# true bila API di belakang reverse proxy (Railway/nginx) agar @Ip() benar.
TRUST_PROXY=false

# Media vendor (upload lokal). MEDIA_PUBLIC_BASE_URL opsional; bila kosong,
# URL memakai host request (cocok untuk dev/emulator).
UPLOAD_DIR=storage/uploads
MEDIA_PUBLIC_BASE_URL=

# Payment gateway (PJP) - see docs/BRIEF-LEGAL-DANA-PAJAK.md, tidak ada kredensial nyata di repo
PJP_PROVIDER=sandbox
PJP_MERCHANT_ID=
PJP_API_KEY=
PJP_WEBHOOK_SECRET=

# Admin panel
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_USE_MOCK=false

# Google Sign-In (opsional; tanpa client id, tombol Google disembunyikan)
# Buat OAuth Client ID di Google Cloud Console > APIs & Services > Credentials.
# Authorized redirect URI (web): http://localhost:3002/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Worker (apps/worker) - poller PostgreSQL, tanpa Redis
WORKER_TICK_MS=15000
WORKER_BATCH=50
# 0 = berjalan terus; >0 = berhenti setelah N tick (untuk uji deterministik)
WORKER_MAX_TICKS=0

# Origin yang boleh memanggil API (dipisah koma). 8080 = mobile web dev.
CORS_ORIGINS=http://localhost:3002,http://localhost:8080
